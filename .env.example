# Copy this file to .env and fill in the values.
# Values here override config.yaml at runtime.
# Never commit .env to git.

# Override the model (optional — defaults to config.yaml llm_deployment)
# RAFM_MODEL=claude-opus-4-5

# Override the APIM endpoint (optional)
# RAFM_ENDPOINT=https://apim-aiservices-prod-01.azure-api.net

# Override the API key (optional)
# RAFM_API_KEY=your-key-here
